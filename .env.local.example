# LiveAvatar API key (server-only — NEVER expose to the frontend)
# Get yours at https://app.liveavatar.com
LIVEAVATAR_API_KEY=

# Sandbox toggle. true = free 1-min sessions with the default test avatar.
# Set to false to use YOUR avatar; you'll then pick avatar + voice in the setup form
# (or pin them via the env vars below).
LIVEAVATAR_SANDBOX=false

# OPTIONAL: pin a default avatar / voice so the form doesn't need a selection.
# When set, these are used as fallbacks if the form leaves them blank.
# LIVEAVATAR_AVATAR_ID=
# LIVEAVATAR_VOICE_ID=

# OPTIONAL: pin a context (system prompt + opening line) instead of creating one per session.
# Create with: POST /v1/contexts (see README for curl example).
# LIVEAVATAR_CONTEXT_ID=
